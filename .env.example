# Copy to .env (git-ignored) and fill in. Real environment variables win over this file.

# --- AI: Claude (Anthropic) ---------------------------------------------------
# Make a key at https://platform.claude.com/settings/keys (it starts with sk-ant-) and put it here.
# It needs credit on that account: a Claude.ai subscription does not pay for API use.
# Nothing else is needed. The key goes only to Anthropic.
CLIPPER_API_KEY=
# Optional. The default is claude-opus-5-5. claude-sonnet-5-5 and claude-haiku-5-5 are cheaper
# (about half and a fortieth of the price per token; see https://platform.claude.com/docs/en/about-claude/pricing).
# CLIPPER_MODEL=claude-opus-5-5
# Optional. How hard Claude thinks before it answers: low, medium, high, xhigh or max. Unset uses the model's
# own default (medium on claude-opus-5-5 and claude-haiku-5-5, high on most others). `low` is faster and cheaper;
# `high` or more thinks harder.
# CLIPPER_EFFORT=low
#
# Any OpenAI-compatible service still works instead (Alibaba's Qwen, OpenAI, a local server, ...):
# set CLIPPER_API_KEY to THAT service's key, and give its address and model. For example, Alibaba (Singapore):
# CLIPPER_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# CLIPPER_MODEL=qwen-plus
# (Alibaba keys belong to a region; a Beijing key needs https://dashscope.aliyuncs.com/compatible-mode/v1.)
# A Claude key is never sent to any address but Anthropic's, so old lines like these are ignored (and reported)
# when your key starts with sk-ant-. To send Claude to a gateway of your own, also set CLIPPER_PROVIDER=anthropic.
# Keys for other providers (OPENAI_API_KEY and the like) are never picked up automatically.

# --- Captions -----------------------------------------------------------------
# What your account is about; keeps caption wording and hashtags consistent.
CLIPPER_NICHE=
# Where your audience is, e.g. "United States" or "UK". Used when researching trends.
CLIPPER_REGION=
# How many of the kept clips must be drama scenes: 6/8, 75% or 0.75. Empty means the default, 75%
# (6 of 8), for the viral profile. 1.0 = all drama, 0.5 = a mixed account, 0 = no drama check.
CLIPPER_DRAMA_SHARE=
# Live trends, on by default: reads public sources (Google Trends, Wikipedia, Bluesky, Mastodon, entertainment
# and gaming news, and, about your niche and the video, news, search suggestions and YouTube's newest videos),
# cross-checks them, and gives the caption writer what is hot right now. No login, no key, and never TikTok
# itself. Refreshed on its own every few hours. 0 turns it off. See the README.
CLIPPER_LIVE_TRENDS=1
# Which sources: default, all, or a list such as "default,reddit" (Reddit restricts automated access).
CLIPPER_TREND_SOURCES=
# Experimental, separate: ask a search-enabled AI model what's trending (cached for 3 days).
# Off by default: on the one account it was tried on, Alibaba's search found nothing usable. Needs an OpenAI-compatible
# service with a search switch, so it does nothing with Claude (the live trends above work with any AI). See the README.
CLIPPER_AUTO_TRENDS=0
# Only if your chat model does not support web search: a search-capable model for research.
CLIPPER_SEARCH_MODEL=
# auto (default): Alibaba's native API for an Alibaba key, the OpenAI-compatible route otherwise.
# The native API returns the sources a search used, so findings can be checked against them;
# the OpenAI-compatible endpoint never does. Force one with: dashscope | compat
CLIPPER_SEARCH_API=auto
# Optional: your own file of trends. It takes priority over automatic research.
# (Create a template with `clipper trends --init`.) Default: ./trends.txt
CLIPPER_TRENDS=

# --- YouTube cookies ----------------------------------------------------------
# Netscape-format export from a logged-in browser session. NEVER commit this file
# (it is git-ignored). It grants access to the account it was exported from.
CLIPPER_COOKIES=cookies.txt
