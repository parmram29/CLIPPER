# Copy to .env (git-ignored) and fill in. Real environment variables win over this file.

# --- AI: any OpenAI-compatible endpoint -------------------------------------
# Default is Alibaba Model Studio (Qwen), international / Singapore endpoint.
# Docs: https://www.alibabacloud.com/help/en/model-studio/text-generation
# Keys are region-specific. A Beijing-issued key needs:
#   CLIPPER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLIPPER_API_KEY=
CLIPPER_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
CLIPPER_MODEL=qwen-plus
# DASHSCOPE_API_KEY is also accepted as the key, but only for aliyuncs.com URLs.
# Keys for other providers (e.g. OPENAI_API_KEY) are never picked up automatically.

# --- YouTube cookies ----------------------------------------------------------
# Netscape-format export from a logged-in browser session. NEVER commit this file
# (it is git-ignored). It grants access to the account it was exported from.
CLIPPER_COOKIES=cookies.txt
