# Copy to .env (git-ignored) and fill in. Real environment variables win over this file.

# --- AI: any OpenAI-compatible endpoint -------------------------------------
# Default is Alibaba Model Studio (Qwen), international / Singapore endpoint.
# Docs: https://www.alibabacloud.com/help/en/model-studio/text-generation
# Keys are region-specific. A Beijing-issued key needs:
#   CLIPPER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLIPPER_API_KEY=
CLIPPER_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
CLIPPER_MODEL=qwen-plus
# DASHSCOPE_API_KEY is also accepted as the key, but only for aliyuncs.com URLs.
# Keys for other providers (e.g. OPENAI_API_KEY) are never picked up automatically.

# --- Captions -----------------------------------------------------------------
# What your account is about; keeps caption wording and hashtags consistent.
CLIPPER_NICHE=
# Where your audience is, e.g. "United States" or "UK". Used when researching trends.
CLIPPER_REGION=
# Trends are researched automatically with web search and cached for 3 days. Set to 0 to turn off.
CLIPPER_AUTO_TRENDS=1
# Only if your chat model does not support web search: a search-capable model for research.
CLIPPER_SEARCH_MODEL=
# auto (default): Alibaba's native API for an Alibaba key, the OpenAI-compatible route otherwise.
# The native API returns the sources a search used, so findings can be checked against them;
# the OpenAI-compatible endpoint never does. Force one with: dashscope | compat
CLIPPER_SEARCH_API=auto
# Optional: your own file of trends. It takes priority over automatic research.
# (Create a template with `clipper trends --init`.) Default: ./trends.txt
CLIPPER_TRENDS=

# --- YouTube cookies ----------------------------------------------------------
# Netscape-format export from a logged-in browser session. NEVER commit this file
# (it is git-ignored). It grants access to the account it was exported from.
CLIPPER_COOKIES=cookies.txt
